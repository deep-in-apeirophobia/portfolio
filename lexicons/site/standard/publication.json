{
  "id": "site.standard.publication",
  "defs": {
    "main": {
      "key": "tid",
      "type": "record",
      "record": {
        "type": "object",
        "required": [
          "url",
          "name"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "icon": {
            "type": "blob",
            "accept": [
              "image/*"
            ],
            "maxSize": 1000000
          },
          "name": {
            "type": "string",
            "maxLength": 1280,
            "maxGraphemes": 128
          },
          "basicTheme": {
            "ref": "site.standard.theme.basic",
            "type": "ref"
          },
          "description": {
            "type": "string",
            "maxLength": 3000,
            "maxGraphemes": 300
          },
          "preferences": {
            "ref": "#preferences",
            "type": "ref"
          }
        }
      }
    },
    "preferences": {
      "type": "object",
      "properties": {
        "showInDiscover": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}